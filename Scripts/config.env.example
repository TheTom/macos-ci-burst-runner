# This file is shell-sourced. Keep it private and do not put credentials here.
# The controller uses the GitHub CLI's existing keychain-backed authentication.

# Choose "org" or "repo".
GITHUB_SCOPE_TYPE=org
GITHUB_OWNER=example-owner

# Required only when GITHUB_SCOPE_TYPE=repo.
GITHUB_REPOSITORY=example-repository

# Choose a unique name for this Mac and a label every eligible workflow requires.
RUNNER_NAME=mac-burst-runner
BURST_LABEL=burst

RUNNER_DIR="$HOME/actions-runner-burst"
MIN_FREE_GIB=100
SETUP_MIN_FREE_GIB=5
DISK_VOLUME=/System/Volumes/Data
USE_CAFFEINATE=1

# --- Tiered disk guard -----------------------------------------------------
# MIN_FREE_GIB is the hard floor: below it a job is denied admission. Crossing
# below SOFT_FREE_GIB only triggers reclamation, never a denial. Defaults to
# twice MIN_FREE_GIB when unset.
SOFT_FREE_GIB=200

# Idle reclamation runs at most this often while the runner is Available and
# free space sits between the floor and the soft threshold.
SWEEP_INTERVAL_SECONDS=3600

# Colon-separated directories or globs the guard may sweep (tier 1) and clean
# (tier 2), visited in this order; within one glob the oldest is handled first.
# Relative entries resolve under the runner's _work directory. Empty means the
# guard only enforces the floor, exactly like the untiered version.
CACHE_DIRS=

# Parent directory of per-run artifact directories. The newest ARTIFACT_KEEP
# subdirectories and the one named after the current GITHUB_RUN_ID are kept;
# older ones are removed (tier 0). Leave empty to disable tier 0.
ARTIFACT_DIR=
ARTIFACT_KEEP=3

# Tier 1 command template run per cache directory when free < SOFT_FREE_GIB.
# "{dir}" and "{days}" are substituted; {dir} is shell-quoted. Leave empty to
# use cargo-sweep when it is on PATH (or in $CARGO_HOME/bin), and to skip the
# tier with a single log line when it is not.
SWEEP_CMD=
SWEEP_DAYS=3

# Tier 2 command template run per cache directory when free < MIN_FREE_GIB,
# during admission only. "{dir}" is substituted. Leave empty to use
# "cargo clean --target-dir {dir}" when cargo is present. With no cargo and no
# template the tier is skipped: set CLEAN_RM=1 to opt in to plain deletion.
CLEAN_CMD=
CLEAN_RM=0

# Cargo example. Replace the paths with the caches your workflows actually
# create, then leave SWEEP_CMD and CLEAN_CMD empty to get cargo-sweep and
# cargo clean automatically:
#
#   CACHE_DIRS="_tool/my-ci/build:*/.ci-cache/*:_temp/*"
#   ARTIFACT_DIR=_tool/my-ci/artifacts
#   SWEEP_DAYS=3
#
# Non-Cargo example, sweeping with find and deleting whole trees at the floor:
#
#   CACHE_DIRS="_tool/gradle-cache/*"
#   SWEEP_CMD="find {dir} -type f -mtime +{days} -delete"
#   CLEAN_RM=1

# Organization scope only. "Default" omits --runnergroup during registration.
RUNNER_GROUP=Default

# BURST_LABEL must appear here. Add architecture or capability labels only when
# workflows also require BURST_LABEL; otherwise the safety toggle can be bypassed.
RUNNER_LABELS=self-hosted,macOS,burst

# Optional comma-separated repositories used only to show the current job in the
# menu. Leave blank to avoid extra API calls. Repo scope automatically uses its repo.
MONITORED_REPOSITORIES=

# Optional fallback when GitHub's release API does not publish an asset digest.
# ACTIONS_RUNNER_SHA256=
